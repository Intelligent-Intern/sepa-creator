{
  "name": "intelligent-intern/sepa-creator",
  "description": "SEPA transfers, direct debits and payment status reading with exact amounts and mandatory offline ISO/business validation.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ~8.5.12",
    "php-64bit": "~8.2.35 || ~8.3.36 || ~8.4.27 || ~8.5.12",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-json": "*",
    "digitick/sepa-xml": "3.2.0"
  },
  "autoload": {
    "psr-4": {
      "IntelligentIntern\\SepaCreator\\": "src/"
    },
    "files": [
      "src/bootstrap.php"
    ]
  },
  "bin": [
    "bin/sepa-creator"
  ],
  "scripts": {
    "test": "php tests/run.php"
  },
  "homepage": "https://github.com/Intelligent-Intern/sepa-creator",
  "support": {
    "issues": "https://github.com/Intelligent-Intern/sepa-creator/issues",
    "source": "https://github.com/Intelligent-Intern/sepa-creator"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/.github",
      "/.cache",
      "/artifacts",
      "/vendor",
      "/composer.lock",
      "/.env",
      "/.env.*",
      "/dist",
      "/*.log"
    ]
  }
}
